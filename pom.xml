<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>org.github.xjrk58</groupId>
    <artifactId>azure-eventhub-connector</artifactId>
    <version>3.7.2-5.21.6</version>
    <packaging>jar</packaging>

    <name>azure-eventhub-connector</name>
    <description>Kafka Connect sink connector for Azure Event Hubs</description>
    <url>https://github.com/emnify/siphon-kafka-connect-eventhub</url>

    <properties>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <maven.compiler.release>11</maven.compiler.release>

        <!--
          Kafka Connect API. `provided` - supplied by the Connect runtime at execution time, so this must be the
          LOWEST runtime the plugin has to run on, not the newest available. EMB runs
          confluentinc/cp-kafka-connect:7.7.7, and Confluent Platform 7.7.x ships Apache Kafka 3.7.x. A plugin
          compiled against a newer Connect API than the runtime provides fails with NoSuchMethodError at the first
          call to anything added in between. Compiling against 3.7 still runs on 3.9 and 4.x.
        -->
        <kafka.version>3.7.2</kafka.version>
        <!-- Azure Event Hubs SDK (com.azure track). Supersedes the retired com.microsoft.azure:azure-eventhubs. -->
        <azure.eventhubs.version>5.21.6</azure.eventhubs.version>

        <!--
          Pinned transitives of the Azure SDK, both to close known CVEs and to keep the Jackson modules on one
          version. See <dependencyManagement> for why each is here.
        -->
        <jackson.version>2.18.10</jackson.version>
        <proton-j.version>0.35.0</proton-j.version>

        <slf4j.version>2.0.17</slf4j.version>
        <junit.version>4.13.2</junit.version>
        <mockito.version>5.23.0</mockito.version>

        <maven-compiler-plugin.version>3.13.0</maven-compiler-plugin.version>
        <maven-surefire-plugin.version>3.5.2</maven-surefire-plugin.version>
        <maven-jar-plugin.version>3.4.2</maven-jar-plugin.version>
        <maven-assembly-plugin.version>3.7.1</maven-assembly-plugin.version>
        <maven-dependency-plugin.version>3.8.1</maven-dependency-plugin.version>
        <versions-maven-plugin.version>2.18.0</versions-maven-plugin.version>
        <dependency-check-maven.version>12.1.3</dependency-check-maven.version>

        <!--
          CVSS score at which the `security-scan` profile fails the build. 7.0 is the floor of "High"; anything
          below is reported but does not block. Raise it only with a suppression entry explaining why.
        -->
        <dependency-check.failBuildOnCVSS>7.0</dependency-check.failBuildOnCVSS>

        <!-- Override at deploy time: -Dcodeartifact.url=https://<domain>-<owner>.d.codeartifact.<region>.amazonaws.com/maven/<repo>/ -->
        <codeartifact.url>https://example.invalid/override-codeartifact-url</codeartifact.url>
    </properties>

    <dependencyManagement>
        <dependencies>
            <!--
              Jackson. connect-json (provided) sits nearer the root than azure-core does, so nearest-wins pulled
              jackson-databind down to 2.16.2 while azure-core's jackson-datatype-jsr310 stayed at 2.18.9 - and
              both shipped in the shaded jar. Jackson does not support mixing module versions, so that pairing was
              unsupported regardless of any CVE. The bom puts every Jackson artifact on one version, which also
              closes CVE-2026-54512/54513 (PolymorphicTypeValidator bypass via generic type ids, fixed in 2.18.8).

              This connector never enables polymorphic typing, so those CVEs were not exploitable here; the skew
              was the real defect. Staying on the 2.18 line keeps us on what azure-core 1.59.0 was built against.
            -->
            <dependency>
                <groupId>com.fasterxml.jackson</groupId>
                <artifactId>jackson-bom</artifactId>
                <version>${jackson.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>

            <!--
              proton-j. azure-core-amqp 2.12.1 - the newest release - still depends on 0.34.1, which Apache flagged
              for a pre-authentication unbounded symbol cache that a peer can drive into resource exhaustion
              (CVE-2026-66257 and five siblings). 0.35.0 is the upstream fix. This is a deliberate override of an
              SDK transitive: drop it once azure-core-amqp ships 0.35.0 itself.
            -->
            <dependency>
                <groupId>org.apache.qpid</groupId>
                <artifactId>proton-j</artifactId>
                <version>${proton-j.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <dependencies>
        <!-- https://mvnrepository.com/artifact/org.apache.kafka/connect-api -->
        <dependency>
            <groupId>org.apache.kafka</groupId>
            <artifactId>connect-api</artifactId>
            <version>${kafka.version}</version>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>org.apache.kafka</groupId>
            <artifactId>connect-json</artifactId>
            <version>${kafka.version}</version>
            <scope>provided</scope>
        </dependency>

        <!-- https://mvnrepository.com/artifact/com.azure/azure-messaging-eventhubs -->
        <dependency>
            <groupId>com.azure</groupId>
            <artifactId>azure-messaging-eventhubs</artifactId>
            <version>${azure.eventhubs.version}</version>
            <exclusions>
                <!--
                  slf4j-api is supplied by the Connect worker. Without this exclusion the assembly bundles the
                  transitive 1.7.x copy into the shaded jar, which shadows the worker's own logging setup.
                -->
                <exclusion>
                    <groupId>org.slf4j</groupId>
                    <artifactId>slf4j-api</artifactId>
                </exclusion>
            </exclusions>
        </dependency>

        <!-- https://mvnrepository.com/artifact/org.slf4j/slf4j-api -->
        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-api</artifactId>
            <version>${slf4j.version}</version>
            <scope>provided</scope>
        </dependency>

        <dependency>
            <groupId>junit</groupId>
            <artifactId>junit</artifactId>
            <version>${junit.version}</version>
            <scope>test</scope>
        </dependency>
        <!-- https://mvnrepository.com/artifact/org.mockito/mockito-core -->
        <dependency>
            <groupId>org.mockito</groupId>
            <artifactId>mockito-core</artifactId>
            <version>${mockito.version}</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <sourceDirectory>src/main/java</sourceDirectory>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>${maven-compiler-plugin.version}</version>
            </plugin>

            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>${maven-surefire-plugin.version}</version>
            </plugin>

            <!-- Stamp the version into the manifest so SinkConnector.version() does not report null. -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-jar-plugin</artifactId>
                <version>${maven-jar-plugin.version}</version>
                <configuration>
                    <archive>
                        <manifest>
                            <addDefaultImplementationEntries>true</addDefaultImplementationEntries>
                            <addDefaultSpecificationEntries>true</addDefaultSpecificationEntries>
                        </manifest>
                    </archive>
                </configuration>
            </plugin>

            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>versions-maven-plugin</artifactId>
                <version>${versions-maven-plugin.version}</version>
            </plugin>

            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-dependency-plugin</artifactId>
                <version>${maven-dependency-plugin.version}</version>
                <executions>
                    <execution>
                        <id>copy-dependencies</id>
                        <phase>prepare-package</phase>
                        <goals>
                            <goal>copy-dependencies</goal>
                        </goals>
                        <configuration>
                            <outputDirectory>${project.build.directory}/lib</outputDirectory>
                            <includeScope>runtime</includeScope>
                            <overWriteReleases>false</overWriteReleases>
                            <overWriteSnapshots>false</overWriteSnapshots>
                            <overWriteIfNewer>true</overWriteIfNewer>
                        </configuration>
                    </execution>
                </executions>
            </plugin>

            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-assembly-plugin</artifactId>
                <version>${maven-assembly-plugin.version}</version>
                <executions>
                    <execution>
                        <id>make-plugin-bundle</id>
                        <phase>package</phase>
                        <goals>
                            <goal>single</goal>
                        </goals>
                        <configuration>
                            <archive>
                                <manifest>
                                    <addClasspath>true</addClasspath>
                                    <classpathPrefix>lib/</classpathPrefix>
                                    <addDefaultImplementationEntries>true</addDefaultImplementationEntries>
                                </manifest>
                            </archive>
                            <descriptorRefs>
                                <descriptorRef>jar-with-dependencies</descriptorRef>
                            </descriptorRefs>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>


    <profiles>
        <!--
          Known-CVE scan of the full transitive tree. Not bound to the default build: dependency-check downloads
          and caches the NVD feed, which needs network access and several minutes on a cold cache, and a build
          that fails because a CVE was published overnight is a build that fails for reasons unrelated to the
          commit. `.github/workflows/security.yml` runs it on a schedule and on demand instead.

              mvn -B verify -Psecurity-scan

          Set NVD_API_KEY to a key from https://nvd.nist.gov/developers/request-an-api-key. Without one the NIST
          API throttles hard and a cold run takes upwards of half an hour.
        -->
        <profile>
            <id>security-scan</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.owasp</groupId>
                        <artifactId>dependency-check-maven</artifactId>
                        <version>${dependency-check-maven.version}</version>
                        <configuration>
                            <nvdApiKey>${env.NVD_API_KEY}</nvdApiKey>
                            <failBuildOnCVSS>${dependency-check.failBuildOnCVSS}</failBuildOnCVSS>
                            <suppressionFiles>
                                <suppressionFile>.owasp-suppressions.xml</suppressionFile>
                            </suppressionFiles>
                            <formats>
                                <format>HTML</format>
                                <format>SARIF</format>
                            </formats>
                            <!--
                              Gate on what actually ships in the shaded jar. skipTestScope drops JUnit and
                              Mockito; skipProvidedScope drops connect-api, connect-json and kafka-clients, which
                              the Connect runtime supplies and which are pinned to the LOWEST supported runtime on
                              purpose (see kafka.version). A CVE there is the cp-kafka-connect image's to fix, and
                              gating this build on it would mean a permanently red build we are not allowed to
                              turn green.

                              To see them anyway - worth doing when choosing a runtime image:
                                  mvn -B verify -Psecurity-scan -Ddependency-check.skipProvidedScope=false
                            -->
                            <skipTestScope>true</skipTestScope>
                            <skipProvidedScope>true</skipProvidedScope>

                            <!--
                              Sonatype OSS Index now answers anonymous callers with 401, and analyzer failures are
                              fatal by design (failOnError defaults to true, which is right - a scan that silently
                              skipped half its analyzers is worse than a red build). Using it properly needs a
                              Sonatype account and credentials in settings.xml; NVD alone is the source until
                              someone decides that is worth doing.
                            -->
                            <ossindexAnalyzerEnabled>false</ossindexAnalyzerEnabled>
                        </configuration>
                        <executions>
                            <execution>
                                <goals>
                                    <goal>check</goal>
                                </goals>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>

    <distributionManagement>
        <!--
          Bintray was shut down in May 2021. The Jenkins pipeline (.jenkins/Jenkinsfile) deploys to AWS
          CodeArtifact using the settings.xml injected from the `MAVEN_SETTINGS` folder property, which is
          expected to supply a mirror for this repository id.
        -->
        <repository>
            <id>emnify-codeartifact</id>
            <name>emnify CodeArtifact</name>
            <url>${codeartifact.url}</url>
        </repository>
    </distributionManagement>

</project>
